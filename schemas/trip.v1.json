{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://journeyin.local/schema/trip/v1.json",
  "title": "JourneyIn Trip",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "title", "status", "timezone", "date_range", "days"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "type": "string", "enum": ["draft", "published", "archived"] },
    "locale": { "type": "string", "maxLength": 32 },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "date_range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      },
      "additionalProperties": false
    },
    "description_markdown": { "type": "string", "maxLength": 20000 },
    "links": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/link" } },
    "map": { "$ref": "#/$defs/map_config" },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/day" }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 2000 },
        "kind": { "type": "string", "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "map_config": {
      "type": "object",
      "properties": {
        "preferred_provider": { "type": "string", "enum": ["baidu", "amap"] },
        "enabled_providers": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["baidu", "amap"] }
        },
        "default_mode": { "type": "string", "enum": ["driving", "walking", "cycling", "transit"] }
      },
      "additionalProperties": false
    },
    "coordinate": {
      "type": "object",
      "required": ["lat", "lng", "crs"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "crs": { "type": "string", "enum": ["wgs84", "gcj02", "bd09ll"] }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["preferred", "coordinates"],
      "properties": {
        "preferred": { "type": "string", "enum": ["wgs84", "gcj02", "bd09ll"] },
        "coordinates": {
          "type": "object",
          "properties": {
            "wgs84": { "$ref": "#/$defs/coordinate" },
            "gcj02": { "$ref": "#/$defs/coordinate" },
            "bd09ll": { "$ref": "#/$defs/coordinate" }
          },
          "additionalProperties": false
        },
        "source": { "type": "string", "maxLength": 100 },
        "provider_refs": { "type": "object", "maxProperties": 20, "additionalProperties": { "type": "string", "maxLength": 200 } },
        "citycode": { "type": "string", "maxLength": 32 },
        "adcode": { "type": "string", "maxLength": 32 },
        "geocoded_at": { "type": "string", "format": "date-time" },
        "precision": { "type": "string", "maxLength": 32 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "day": {
      "type": "object",
      "required": ["id", "date", "stops"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "title": { "type": "string", "maxLength": 120 },
        "notes_markdown": { "type": "string", "maxLength": 10000 },
        "stops": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/stop" } },
        "legs": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/route_leg" } }
      },
      "additionalProperties": false
    },
    "stop": {
      "type": "object",
      "required": ["id", "sequence", "title"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sequence": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "address": { "type": "string", "maxLength": 500 },
        "location": { "$ref": "#/$defs/location" },
        "time_window": { "type": "object" },
        "description_markdown": { "type": "string", "maxLength": 10000 },
        "links": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/link" } },
        "weather": { "type": "object" },
        "children": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/sub_stop" } }
      },
      "additionalProperties": false
    },
    "sub_stop": {
      "type": "object",
      "required": ["id", "sequence", "title"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sequence": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "address": { "type": "string", "maxLength": 500 },
        "location": { "$ref": "#/$defs/location" },
        "time_window": { "type": "object" },
        "description_markdown": { "type": "string", "maxLength": 10000 },
        "links": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/link" } },
        "weather": { "type": "object" }
      },
      "additionalProperties": false
    },
    "route_leg": {
      "type": "object",
      "required": ["id", "from_stop_id", "to_stop_id"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "from_stop_id": { "type": "string", "maxLength": 128 },
        "to_stop_id": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "enum": ["driving", "walking", "cycling", "transit"] },
        "snapshots": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/route_snapshot" } }
      },
      "additionalProperties": false
    },
    "route_snapshot": {
      "type": "object",
      "required": ["provider", "coordinate_system"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "coordinate_system": { "type": "string", "enum": ["wgs84", "gcj02", "bd09ll"] },
        "mode": { "type": "string", "enum": ["driving", "walking", "cycling", "transit"] },
        "strategy": { "type": "string", "maxLength": 64 },
        "source": { "type": "string", "maxLength": 128 },
        "geometry": {
          "type": "array",
          "maxItems": 20000,
          "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
        },
        "distance_m": { "type": "integer", "minimum": 0 },
        "duration_s": { "type": "integer", "minimum": 0 },
        "fetched_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
